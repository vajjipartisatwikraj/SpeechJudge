# Speech Judge: configuration for AWS EC2 m7i.2xlarge (8 vCPU / 32 GiB, CPU only), PM2 deployment.
# Copy to <repo>/speech-judge/.env on the server and set SJ_SERVICE_CREDENTIALS. Guide: docs/EC2_M7I_PM2_DEPLOYMENT.md

# ---- Server ---------------------------------------------------------------------------------
SJ_ENVIRONMENT=production
SJ_HOST=127.0.0.1                 # reach it through an SSH tunnel / reverse proxy; never bind a public interface
SJ_PORT=8000
SJ_LOG_LEVEL=INFO
SJ_ENABLE_DOCS=false

# Generate:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"   (>= 24 chars or startup is refused)
SJ_SERVICE_CREDENTIALS=PASTE_LONG_RANDOM_VALUE_HERE

# ---- Models (both must be true in production) -----------------------------------------------
SJ_MOCK_MODE=false
SJ_PRONUNCIATION_ENABLED=true
SJ_QWEN_ENABLED=true

# ---- Hardware: THE switch between the CPU and the GPU architecture -------------------------------
# false -> CPU profile (app/core/hardware.py): device cpu, Whisper small.en int8, no batching,
#          SJ_SECTION_PROCESSING_TIMEOUT_S=3600 (a 24-question Q&A section needs ~25 min of Qwen on CPU).
# Do not set SJ_DEVICE / SJ_WHISPER_MODEL / SJ_WHISPER_COMPUTE_TYPE / batch sizes here; they follow this switch.
SJ_GPU_PRESENT=false

# ---- Process layout: pick ONE block ------------------------------------------------------------
# Layout A: one PM2 process (judge-api) holds the models; supports sync + async endpoints.
SJ_JOB_BACKEND=inline
SJ_LOAD_MODELS_IN_API=true
# Layout B: judge-api (gateway) + judge-worker (models) + Redis queue; async endpoints only.
# SJ_JOB_BACKEND=celery
# SJ_LOAD_MODELS_IN_API=false
SJ_REDIS_URL=redis://127.0.0.1:6379/0

# ---- CPU thread budget: 8 vCPU = Whisper 2 + Pronunciation 2 + Qwen 4 (API/Redis/acoustic share) --
SJ_WHISPER_LANGUAGE=en
SJ_WHISPER_CPU_THREADS=2
SJ_PRONUNCIATION_BACKEND=phoneme
SJ_PHONEME_THREADS=2
SJ_QWEN_BACKEND=ollama
SJ_OLLAMA_URL=http://127.0.0.1:11434
SJ_OLLAMA_MODEL=qwen3:4b
SJ_OLLAMA_NUM_THREAD=4
SJ_OLLAMA_TIMEOUT_S=600
SJ_LLM_RETRY_LIMIT=2
SJ_LLM_JUSTIFICATIONS=true        # false = scores only, roughly 2x faster open answers (no per-dimension comments)

# ---- Limits and timeouts -----------------------------------------------------------------------
SJ_FFMPEG_PATH=ffmpeg
SJ_MAX_AUDIO_BYTES=15728640
SJ_MAX_AUDIO_SECONDS=180
SJ_REQUEST_TIMEOUT_S=900          # Layout A synchronous calls; Qwen answers take ~1 min each on CPU
SJ_MAX_CONCURRENT_EVALUATIONS=6   # Layout A: more simultaneous sync calls get HTTP 429 + Retry-After
SJ_PROCESSING_TIMEOUT_S=900       # Layout B: a job stuck in PROCESSING this long is reported "Worker lost"
SJ_JOB_RETRY_LIMIT=2
SJ_JOB_RETENTION_S=86400
