# Speech Judge: configuration for a GPU server with an NVIDIA RTX 5070 (12 GB VRAM, Blackwell, sm_120).
# Copy to <repo>/speech-judge/.env on the server and set SJ_SERVICE_CREDENTIALS.
#
# Software this card needs (older builds fail with "no kernel image is available" or fall back to the CPU):
#   * NVIDIA driver 570 or newer (CUDA 12.8 capable)           check:  nvidia-smi
#   * PyTorch built for CUDA 12.8                               pip install torch --index-url https://download.pytorch.org/whl/cu128
#   * CTranslate2 >= 4.6 (faster-whisper, CUDA 12.8 wheel)      check:  python -c "import ctranslate2; print(ctranslate2.__version__)"
#   * Ollama (recent)                                           it ships its own CUDA runtime
# See requirements-gpu.txt. The service refuses to start with SJ_GPU_PRESENT=true when the GPU cannot be used.

# ---- Server ---------------------------------------------------------------------------------
SJ_ENVIRONMENT=production
SJ_HOST=127.0.0.1                 # reach it through an SSH tunnel / reverse proxy; never bind a public interface
SJ_PORT=8000
SJ_LOG_LEVEL=INFO
SJ_ENABLE_DOCS=false

# Generate:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"   (>= 24 chars or startup is refused)
SJ_SERVICE_CREDENTIALS=PASTE_LONG_RANDOM_VALUE_HERE

# ---- Models (both must be true in production) -----------------------------------------------
SJ_MOCK_MODE=false
SJ_GPU_PRESENT=true               # GPU profile (app/core/hardware.py): device cuda, large-v3-turbo float16, batches of 10
SJ_PRONUNCIATION_ENABLED=true
SJ_QWEN_ENABLED=true

# ---- Process layout: API gateway + ONE worker process that owns the models ----------------------
# judge-api only accepts requests and puts section jobs on the Redis queue; judge-worker holds the single
# Whisper / phoneme / Qwen and runs the stage queues that batch their calls.
SJ_JOB_BACKEND=celery
SJ_LOAD_MODELS_IN_API=false
SJ_REDIS_URL=redis://127.0.0.1:6379/0
# pm2 / shell: JUDGE_WORKER_CONCURRENCY=2  -> two sections processed at the same time on the shared models

# ---- Whisper (faster-whisper / CTranslate2) --------------------------------------------------------
SJ_WHISPER_MODEL=large-v3-turbo    # 4 decoder layers instead of 32: much faster, ~1.6 GB VRAM (large-v3 = slower, ~3 GB)
SJ_WHISPER_COMPUTE_TYPE=float16
SJ_WHISPER_LANGUAGE=en
SJ_WHISPER_BEAM_SIZE=3             # decoding beam: lower = faster (1 = greedy), higher = slightly more accurate

# ---- Pronunciation (wav2vec2 phoneme model, PyTorch) ----------------------------------------------
SJ_PRONUNCIATION_BACKEND=phoneme
SJ_ACCENT_PROFILE_PATH=config/accents/indian_english.yaml

# ---- Qwen: use Ollama (quantised, ~3 GB). The transformers backend needs ~8 GB in bf16 and would -----
# ---- not fit next to Whisper and the phoneme model on a 12 GB card. --------------------------------
SJ_QWEN_BACKEND=ollama
SJ_OLLAMA_URL=http://127.0.0.1:11434
SJ_OLLAMA_MODEL=qwen3:4b
SJ_OLLAMA_TIMEOUT_S=300
SJ_LLM_RETRY_LIMIT=2
SJ_LLM_JUSTIFICATIONS=true

# ---- Shared stage queues / batching ------------------------------------------------------------------
SJ_WHISPER_BATCH_SIZE=10           # clips decoded together on the GPU (1 = no batching)
SJ_PHONEME_BATCH_SIZE=10
SJ_BATCH_MAX_WAIT_MS=300           # a partial batch is dispatched after this long
SJ_QWEN_STAGE_WORKERS=1            # raise only together with OLLAMA_NUM_PARALLEL on the Ollama service
SJ_SECTION_QUESTION_PARALLELISM=16 # questions of one section processed at once (>= batch size)

# ---- Limits and timeouts -----------------------------------------------------------------------
SJ_FFMPEG_PATH=ffmpeg
SJ_MAX_AUDIO_BYTES=15728640
SJ_MAX_AUDIO_SECONDS=180
SJ_SECTION_MAX_QUESTIONS=50
SJ_SECTION_MAX_TOTAL_AUDIO_BYTES=125829120
SJ_PROCESSING_TIMEOUT_S=300
SJ_SECTION_PROCESSING_TIMEOUT_S=900   # a section job stuck in PROCESSING this long is reported "Worker lost"
SJ_JOB_RETRY_LIMIT=2
SJ_JOB_RETENTION_S=86400

# ---- Benchmarks (test console "Benchmarks" tab) ----------------------------------------------------
# Lets the authenticated API start benchmarks/*.py. Turn it on while measuring, off for real exams.
SJ_BENCHMARKS_ENABLED=true
