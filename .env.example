# =============================================================================================
# Speech Judge - environment configuration
#
#   cp .env.example .env     then edit .env   (.env is git-ignored; never commit it)
#
# Backend variables start with SJ_. Real environment variables override this file.
# The frontend test console (frontend/server.py) reads this same file for the backend address
# and credential, so backend and frontend stay in sync from a single place.
# =============================================================================================

# ---- Server -------------------------------------------------------------------------------
SJ_ENVIRONMENT=local            # local | production  (production enforces the checks below)
SJ_HOST=127.0.0.1               # 0.0.0.0 inside Docker; keep on a private network, no public ingress
SJ_PORT=8000
SJ_LOG_LEVEL=INFO
SJ_ENABLE_DOCS=false            # serve /docs and /openapi.json; must be false in production

# ---- Access control -----------------------------------------------------------------------
# Comma-separated credentials the Main Application sends as "Authorization: Bearer <value>".
# Production: at least 24 random characters each, e.g.  python -c "import secrets;print(secrets.token_urlsafe(32))"
SJ_SERVICE_CREDENTIALS=change-me

# ---- Mode and process layout --------------------------------------------------------------
SJ_MOCK_MODE=false              # true: every model is mocked (no downloads, instant); never in production

# THE hardware switch. false = CPU-only server, true = server with an NVIDIA GPU.
# It picks the defaults for the lines marked [profile] below (see app/core/hardware.py):
#                       false (CPU)         true (GPU)
#   device              cpu                 cuda
#   Whisper model       small.en / int8     large-v3-turbo / float16
#   Whisper/phoneme batch   1 / 1            10 / 10
#   section timeout     3600 s              900 s
# Leave the [profile] lines commented out; a value you set explicitly always wins. A contradicting
# SJ_DEVICE (cuda with false, cpu with true) stops the service at start-up.
SJ_GPU_PRESENT=false

SJ_JOB_BACKEND=inline           # inline (threads, no Redis) | celery (Redis queue + workers)
SJ_LOAD_MODELS_IN_API=true      # false = API gateway only; models live in the Celery workers
SJ_REDIS_URL=redis://localhost:6379/0

# ---- Service switches ---------------------------------------------------------------------
# false = that service is replaced by a MOCK returning fixed placeholder values (no model is loaded),
# and every result that used it carries a MOCKED_* flag. Refused when SJ_ENVIRONMENT=production.
SJ_PRONUNCIATION_ENABLED=true       # false: Reading / Repeat get mock pronunciation + completeness
SJ_QWEN_ENABLED=true                # false: Q&A / Storytelling get mock language scores
# ---- Speech-to-text (Whisper) -------------------------------------------------------------
# [profile] CPU: small.en / int8 | GPU: large-v3-turbo / float16. Uncomment only to override the profile.
# SJ_WHISPER_MODEL=
# SJ_WHISPER_COMPUTE_TYPE=
SJ_WHISPER_LANGUAGE=en
SJ_WHISPER_BEAM_SIZE=3          # decoding beam: lower = faster (1 = greedy), higher = slightly more accurate
# CPU thread budget per model (0 = library default). Only matters on CPU-only servers; see docs/EC2_M7I_PM2_DEPLOYMENT.md
SJ_WHISPER_CPU_THREADS=0
SJ_PHONEME_THREADS=0
SJ_OLLAMA_NUM_THREAD=0
# ---- Pronunciation ------------------------------------------------------------------------
SJ_PRONUNCIATION_BACKEND=phoneme    # phoneme | gopt | mock
SJ_PHONEME_MODEL=                   # empty = model named in the accent profile
SJ_ACCENT_PROFILE_PATH=config/accents/indian_english.yaml
# Only for SJ_PRONUNCIATION_BACKEND=gopt:
SJ_GOPT_BACKEND=
SJ_GOPT_CHECKPOINT=

# ---- Language evaluation (Qwen3) ----------------------------------------------------------
SJ_QWEN_BACKEND=ollama              # ollama (CPU ok) | transformers (GPU)
SJ_OLLAMA_URL=http://localhost:11434
SJ_OLLAMA_MODEL=qwen3:4b
SJ_OLLAMA_TIMEOUT_S=300
SJ_QWEN_MODEL_PATH=Qwen/Qwen3-4B    # transformers backend only
SJ_QWEN_MAX_NEW_TOKENS=700
SJ_LLM_RETRY_LIMIT=2
SJ_PROMPT_VERSION=v1
SJ_LLM_JUSTIFICATIONS=true            # false = scores only (no per-dimension comments): about 2x faster on CPU

# ---- Audio limits and quality gate --------------------------------------------------------
SJ_MAX_AUDIO_BYTES=15728640
SJ_MAX_AUDIO_SECONDS=180
SJ_FFMPEG_PATH=ffmpeg               # needed for mp3/ogg/webm/m4a; WAV works without it
SJ_MIN_DURATION_S=1.0
SJ_MIN_SPEECH_S=0.5
SJ_SNR_THRESHOLD_DB=10
SJ_CLIPPING_THRESHOLD=0.01

# ---- Scoring ------------------------------------------------------------------------------
SJ_SCORING_CONFIG_PATH=config/scoring.yaml

# ---- Timeouts and jobs --------------------------------------------------------------------
SJ_REQUEST_TIMEOUT_S=600            # synchronous /evaluate (CPU Qwen can take ~1 min)
SJ_MAX_CONCURRENT_EVALUATIONS=12       # sync /evaluate calls in flight; more get HTTP 429 + Retry-After (0 = unlimited)
SJ_PROCESSING_TIMEOUT_S=300         # job stuck in PROCESSING longer than this -> FAILED "Worker lost"
SJ_JOB_RETRY_LIMIT=2
SJ_JOB_RETENTION_S=86400            # job results expire after 24 h

# ---- Sections: POST /api/v1/evaluate/section (all questions of an exam section in one request) --
SJ_SECTION_MAX_QUESTIONS=50
SJ_SECTION_MAX_TOTAL_AUDIO_BYTES=125829120   # all audio of one section together (120 MiB)
# [profile] a section job stuck in PROCESSING this long -> FAILED "Worker lost". CPU: 3600 | GPU: 900
# SJ_SECTION_PROCESSING_TIMEOUT_S=
SJ_SECTION_QUESTION_PARALLELISM=16           # questions of one section processed at once (>= batch size)

# ---- Shared stage queues / batching (section worker) ----------------------------------------------
# One Whisper, one phoneme model and one Qwen serve all students; calls wait in a queue per model and the
# Whisper / phoneme workers take up to *_BATCH_SIZE of them as ONE GPU batch (1 = no batching).
# [profile] CPU: 1 / 1 (no batching) | GPU: 10 / 10
# SJ_WHISPER_BATCH_SIZE=
# SJ_PHONEME_BATCH_SIZE=
SJ_BATCH_MAX_WAIT_MS=300            # a partial batch is dispatched after this long
SJ_QWEN_STAGE_WORKERS=1             # concurrent Qwen requests; >1 only helps with OLLAMA_NUM_PARALLEL

# ---- Benchmarks ---------------------------------------------------------------------------------
# true: the authenticated API can start benchmarks/*.py (test console "Benchmarks" tab). GPU server only.
SJ_BENCHMARKS_ENABLED=false

# =============================================================================================
# Frontend test console (frontend/server.py) - not read by the backend
# =============================================================================================
FRONTEND_PORT=8080
# BACKEND_URL=http://127.0.0.1:8000     # default is built from SJ_HOST / SJ_PORT
# FRONTEND_API_KEY=                     # default is the first SJ_SERVICE_CREDENTIALS value
